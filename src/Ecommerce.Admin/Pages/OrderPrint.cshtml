@page
@model Ecommerce.Admin.Pages.OrderPrintModel
@{
    ViewData["Title"] = $"Otpremnica i Obrazac za odustanak — {Model.Order?.OrderNumber}";
}

@if (Model.Order is not null)
{
    var o = Model.Order;
    <div class="d-print-none mb-3 d-flex justify-content-between align-items-center">
        <a asp-page="/Orders" class="btn btn-sm btn-outline-secondary">&larr; Nazad na porudžbine</a>
        <button type="button" onclick="window.print()" class="btn btn-sm btn-primary fw-bold">
            Štampaj Otpremnicu + Zakonski obrazac (A4)
        </button>
    </div>

    <div class="bg-white p-4 border rounded shadow-sm">
        <div class="d-flex justify-content-between align-items-start border-bottom pb-3 mb-3">
            <div>
                <h4 class="fw-bold mb-0">ALATI &amp; DOMAĆINSTVO — OTPREMNICA / LISTA ZA PAKOVANJE</h4>
                <div class="small text-muted">Dokument uz pošiljku (Section 12.1 &amp; 22)</div>
            </div>
            <div class="text-end small">
                <div class="fw-bold fs-5">@o.OrderNumber</div>
                <div>Datum: @o.CreatedAt.ToString("dd.MM.yyyy. HH:mm")</div>
                <div>Fiskalni PFR ref: <strong>@(o.FiscalDocumentRef ?? "Upisati pre predaje kuriru")</strong></div>
            </div>
        </div>

        <div class="row mb-3 small">
            <div class="col-6">
                <strong>Primalac pošiljke:</strong><br />
                @o.CustomerFullName<br />
                @o.ShippingStreet<br />
                @o.ShippingPostalCode @o.ShippingCity<br />
                Telefon: <strong>@o.CustomerPhoneE164</strong> | Email: @o.CustomerEmail
            </div>
            <div class="col-6 text-end">
                <strong>Način naplate:</strong> @o.PaymentMethod<br />
                <strong>Status plaćanja:</strong> @o.PaymentStatus<br />
                <div class="mt-2 p-2 border rounded bg-light d-inline-block">
                    Za naplatu kuriru (Otkupnina): <strong class="fs-6">@o.TotalRsd.ToString("N2") RSD</strong>
                </div>
            </div>
        </div>

        <table class="table table-sm table-bordered small align-middle mb-3">
            <thead class="table-light">
                <tr>
                    <th>R.br</th>
                    <th>Interni SKU</th>
                    <th>Naziv artikla</th>
                    <th>Izvor pakovanja</th>
                    <th>Kol.</th>
                    <th>Jed. cena (RSD)</th>
                    <th>Ukupno (RSD)</th>
                </tr>
            </thead>
            <tbody>
                @{ var idx = 1; }
                @foreach (var item in o.Items)
                {
                    <tr>
                        <td>@(idx++)</td>
                        <td><code>@item.SkuSnapshot</code></td>
                        <td>@item.ProductNameSnapshot</td>
                        <td>@item.FulfillmentSource</td>
                        <td class="fw-bold">@item.Quantity</td>
                        <td>@item.UnitPriceRsd.ToString("N2")</td>
                        <td class="fw-bold">@item.LineTotalRsd.ToString("N2")</td>
                    </tr>
                }
            </tbody>
        </table>

        <div class="text-end small mb-4">
            Međuzbir: <strong>@o.SubtotalRsd.ToString("N2") RSD</strong>
            @if (o.DiscountRsd > 0)
            {
                <span> | Popust (@o.CouponCode): <strong>-@o.DiscountRsd.ToString("N2") RSD</strong></span>
            }
            | Trošak isporuke: <strong>@o.ShippingCostRsd.ToString("N2") RSD</strong>
            | Ukupno: <strong>@o.TotalRsd.ToString("N2") RSD</strong>
        </div>

        <hr class="my-4" style="border-top: 2px dashed #64748b;" />

        <div class="small">
            <h6 class="fw-bold text-uppercase mb-1">OBRAZAC ZA ODUSTANAK OD UGOVORA ZAKLJUČENOG NA DALJINU</h6>
            <p class="text-muted mb-2" style="font-size:11px;">
                (U skladu sa članom 26. i članom 27. Zakona o zaštiti potrošača Republike Srbije — popunite i pošaljite ovaj obrazac isključivo ukoliko želite da odustanete od ugovora u roku od 14 kalendarskih dana od dana prijema robe, ili zahtev podnesite elektronski na stranici <code>/reklamacije</code>).
            </p>
            <div class="border p-3 rounded bg-light" style="font-size:12px;">
                <div><strong>1. Broj porudžbine / ugovora:</strong> @o.OrderNumber &nbsp;&nbsp;|&nbsp;&nbsp; <strong>Broj fiskalnog računa:</strong> @(o.FiscalDocumentRef ?? "__________________")</div>
                <div class="mt-1"><strong>2. Ime, prezime i adresa potrošača:</strong> @o.CustomerFullName, @o.ShippingStreet, @o.ShippingPostalCode @o.ShippingCity</div>
                <div class="mt-1"><strong>3. Naziv artikla koji se vraća nekorišćen u originalnoj ambalaži:</strong> ________________________________________________</div>
                <div class="mt-1"><strong>4. Broj tekućeg računa kupca za povrat sredstava (18 cifara):</strong> ________________________________________________</div>
                <div class="mt-3 d-flex justify-content-between">
                    <span>Datum podnošenja izjave: ____.____.2026.</span>
                    <span>Potpis potrošača (samo ako se šalje u papirnoj formi): ______________________</span>
                </div>
            </div>
        </div>
    </div>
}
